# Database
# Local development uses a SQLite file. In production, use a Turso database URL (libsql://...).
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Admin dashboard
ADMIN_PASSWORD=change-this-password
# Any long random string (at least 32 characters). Required in production.
SESSION_SECRET=replace-with-a-long-random-string-of-at-least-32-chars

# Shows a demo banner and the demo admin password on the login page.
# Set to false for a real clinic.
DEMO_MODE=true
